{
  "system": {
    "host": "<ENV:HOST|0.0.0.0>",
    "port": "<ENV:PORT|21172>",
    "requireAuth": true,
    "dataFile": "data.json",
    "dataSaveIntervalSecs": 180,
    "proxyTestUrl": "https://www.gstatic.com/generate_204",
    "keys": {
      "admin-1": {
        "key": "<ENV:BR_ADMIN_KEY|br_admin_example_change-me>",
        "enabled": true,
      },
    },
    "limits": {
      "maxBodyMB": 10,
    },
  },
  "providers": {
    "openai": {
      "name": "OpenAI",
      "prefix": "openai",
      "type": "openai",
      "interface": "chat-completions",
      "baseUrl": "https://api.openai.com/v1",
      "enabled": true,
      "timeoutSecs": 60,
      "keys": {
        "key-1": {
          "key": "<ENV:OPENAI_KEY_1|sk-example-1>",
          "order": 1,
          "enabled": true,
        },
        "key-2": {
          "key": "<ENV:OPENAI_KEY_2|sk-example-2>",
          "order": 2,
          "enabled": true,
        },
      },
      "models": {
        "gpt-4o-mini": {
          "name": "GPT-4o Mini",
          "enabled": true,
          "created": 1686935002,
          "input": ["text", "image"],
          "limit": { "context": 128000, "output": 16384 },
        },
      },
    },
    "google": {
      "name": "Google",
      "prefix": "gemini",
      "type": "google",
      "interface": "interactions",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "enabled": true,
      "timeoutSecs": 60,
      "keys": {
        "key-1": {
          "key": "<ENV:GEMINI_KEY_1|AIza-example-1>",
          "order": 1,
          "enabled": true,
        },
      },
      "models": {
        "gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash",
          "enabled": true,
          "input": ["text", "image", "audio", "video", "pdf"],
          "limit": { "context": 1000000, "output": 65536 },
        },
      },
    },
  },
  "proxyPools": {
    "pool-eu": {
      "type": "http",
      "url": "http://customer123:your_password@proxy.example.com:8080",
      "order": 1,
      "enabled": true,
    },
    "pool-relay": {
      "type": "relay",
      "url": "https://your-relay.vercel.app",
      "order": 2,
      "enabled": false,
    },
  },
}
